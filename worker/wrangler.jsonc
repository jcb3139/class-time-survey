{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "class-time-survey-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-31",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://YOUR-GITHUB-USERNAME.github.io",
    "ALLOWED_HOSTNAME": "YOUR-GITHUB-USERNAME.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "class-time-survey",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
